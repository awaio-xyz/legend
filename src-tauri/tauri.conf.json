{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legend",
  "version": "0.1.95",
  "identifier": "xyz.awaio.legend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Legend",
        "width": 1280,
        "height": 860
      },
      {
        "label": "widget",
        "title": "Legend widget",
        "width": 240,
        "height": 240,
        "minWidth": 120,
        "minHeight": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
